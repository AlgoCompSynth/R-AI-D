echo ""
echo "Setting container environment variables:"

# User-maintained options

# https://posit.co/download/rstudio-server
export RSTUDIO_SERVER_VERSION="2026.04.0-526"
export RSTUDIO_SERVER_PACKAGE="rstudio-server-$RSTUDIO_SERVER_VERSION-amd64.deb"
export RSTUDIO_SERVER_URL="https://download2.rstudio.org/server/jammy/amd64/$RSTUDIO_SERVER_PACKAGE"
echo "RSTUDIO_SERVER_VERSION: $RSTUDIO_SERVER_VERSION"

# comment out for latest stable version of Ollama
# https://github.com/ollama/ollama/tags
export OLLAMA_VERSION=0.30.0-rc20
echo "OLLAMA_VERSION: $OLLAMA_VERSION"

# uncomment to force a CPU container even on a machine with an NVIDIA GPU
#
# export FORCE_CPU="FORCE_CPU"
# echo "FORCE_CPU: $FORCE_CPU"

# ** You should not need to change anything below here **

## `COMPUTE_MODE`

## R-AI-D can build two types of containers:
##
## 1. COMPUTE_MODE=CPU - only the CPU will be used, and
## 2. COMPUTE_MODE=CUDA - the CPU and an NVIDIA GPU will be used.

## If the "FORCE_CPU" environment variable is unset or does not equal "FORCE_CPU"
## AND the NVIDIA container toolkit detects one or more GPUs
## ADN the architecture is `x86_64`, `COMPUTE_MODE` will be set to
## `CUDA`; otherwise it will be set to `CPU`.
export ARCH="$(uname -m)"
echo "ARCH: $ARCH"

if [[ "$FORCE_CPU" != "FORCE_CPU" \
  && "$ARCH" == "x86_64" \
  && "$(nvidia-ctk cdi list 2>&1 || true | grep gpu | wc -l)" != "0" ]]

then
  export COMPUTE_MODE="CUDA"
  export NVIDIA_FLAGS="--device=nvidia.com/gpu=all"
  # see https://distrobox.it/useful_tips/#using-nvidia-container-toolkit

else
  export COMPUTE_MODE="CPU"
  export NVIDIA_FLAGS=""

fi

echo "COMPUTE_MODE: $COMPUTE_MODE"
echo "NVIDIA_FLAGS: $NVIDIA_FLAGS"

## SELinux logic
## See https://podman-desktop.io/docs/podman/gpu, Linux tab, section 4
##

if [[ "$(which getenforce | wc -l)" == "0" ]]

then
  export SELINUX_STATUS="No_getenforce"
  export SECURITY_FLAGS=""

else
  export SELINUX_STATUS=$(getenforce)

  if [[ "$SELINUX_STATUS" == "Disabled" ]]

  then
    export SECURITY_FLAGS=""

  else
    export SECURITY_FLAGS="--security-opt=label=disable"

  fi

fi

echo "SELINUX_STATUS: $SELINUX_STATUS"
echo "SECURITY_FLAGS: $SECURITY_FLAGS"

## containerfile name
export CONTAINERFILE="Containerfile.base"

## Distrobox
export CONTAINER_NAME="R-AI-D-$COMPUTE_MODE"
export CONTAINER_IMAGE="localhost/r-ai-d-base:latest"

## Desktop folders
export LOCALBIN=$HOME/.local/bin; mkdir --parents $LOCALBIN
export LOGFILES=$HOME/Logfiles; mkdir --parents $LOGFILES
export PROJECTS=$HOME/Projects; mkdir --parents $PROJECTS

if [[ ! "$PATH" =~ "$HOME/.local/bin" ]]

then
  echo "Prepending $LOCALBIN to \$PATH"
  export PATH="$HOME/.local/bin:$PATH"

fi

## Port numbers
export RSTUDIO_SERVER_PORT="8787"
export OLLAMA_SERVER_PORT="11434"
export SSH_SERVER_PORT="2222"

echo ""
