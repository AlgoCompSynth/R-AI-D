FROM docker.io/library/ubuntu:resolute
LABEL maintainer="M. Edward (Ed) Borasky <znmeb@algocompsynth.com>"

# set aside a script / logfile depository
USER root
ENV WORKDIR=/usr/local/src/r-ai-d
WORKDIR $WORKDIR

RUN cat /etc/resolv.conf # check DNS settings

# Environment variables and install scripts
COPY set_container_envars ./
COPY image-installers/* ./

# R-AI-D base
RUN ./r-ai-d-base.sh \
  2>&1 | gzip -9c > $WORKDIR/r-ai-d-base.log.gz

# Quarto CLI
RUN /usr/bin/time ./quarto-cli.sh \
  2>&1 | gzip -9c > $WORKDIR/quarto-cli.log.gz

# R developer packages
RUN /usr/bin/time ./developer-packages.R \
  2>&1 | gzip -9c > $WORKDIR/developer-packages.log.gz

# R AI packages
RUN /usr/bin/time ./ai-packages.R \
  2>&1 | gzip -9c > $WORKDIR/ai-packages.log.gz

# R audio packages
RUN /usr/bin/time ./audio-packages.R \
  2>&1 | gzip -9c > $WORKDIR/audio-packages.log.gz

# Ollama
RUN /usr/bin/time ./ollama.sh \
  2>&1 | gzip -9c > $WORKDIR/ollama.log.gz

# Script finish check!
RUN gzip -dc *.gz | grep "Finished"

# Create an administrator account:
# Username and initial password are defined here;
# the user must change the password on first run
# of the container!
ENV ADMIN_USER="r-ai-d"
ENV ADMIN_PASSWORD="r-ai-d"
ENV ADMIN_HOME=/home/$ADMIN_USER
ENV ADMIN_PROJECTS=$ADMIN_HOME/Projects
ENV ADMIN_LOGFILES=$ADMIN_HOME/Logfiles
ENV ADMIN_SCRIPTS=$ADMIN_HOME/command-line-installers

RUN useradd \
  --comment "Administrator" \
  --groups sudo,adm,systemd-journal,ollama \
  --create-home \
  --shell /usr/bin/bash \
  --user-group \
  $ADMIN_USER \
  && echo "$ADMIN_USER:$ADMIN_PASSWORD" | chpasswd \
  && chage --lastday 0 $ADMIN_USER \
  && mkdir --parents $ADMIN_PROJECTS $ADMIN_LOGFILES $ADMIN_SCRIPTS

# Set up command line
COPY command-line-installers/* $ADMIN_SCRIPTS/
RUN chown --recursive $ADMIN_USER:$ADMIN_USER $ADMIN_HOME
WORKDIR $ADMIN_SCRIPTS
USER $ADMIN_USER
RUN CONTAINER_ID=true ./1_command_line_setup.sh \
  2>&1 | gzip -9c > $ADMIN_LOGFILES/1_command_line_setup.log.gz

# Script finish check!
WORKDIR $ADMIN_LOGFILES
RUN gzip -dc *.gz | grep "Finished"

# Go back to root for systemd!
USER root
WORKDIR $WORKDIR
CMD /sbin/init
