FROM docker.io/library/ubuntu:resolute
LABEL maintainer="M. Edward (Ed) Borasky <znmeb@algocompsynth.com>"

# set aside a script / logfile depository
USER root
ENV WORKDIR=/usr/local/src/r-ai-d
WORKDIR $WORKDIR

RUN cat /etc/resolv.conf # check DNS settings

# Environment variables and install scripts
COPY set_container_envars ./
COPY image-installers/* ./

# R-AI-D base
RUN ./r-ai-d-base.sh \
  | gzip -9c > $WORKDIR/r-ai-d-base.log.gz

# Quarto CLI
RUN ./quarto-cli.sh \
  | gzip -9c > $WORKDIR/quarto-cli.log.gz

# R developer packages
RUN ./developer-packages.R \
  | gzip -9c > $WORKDIR/developer-packages.log.gz

# R AI packages
RUN ./ai-packages.R \
  | gzip -9c > $WORKDIR/ai-packages.log.gz

# R audio packages
RUN ./audio-packages.R \
  | gzip -9c > $WORKDIR/audio-packages.log.gz

# Ollama
RUN ./ollama.sh \
  | gzip -9c > $WORKDIR/ollama.log.gz

# Create an administrator account:
# Username is passed in from the build script as a parameter.
# The user must change the password on first run
# of the container!
ENV ADMIN_HOME=/home/$ADMIN_USER
ENV ADMIN_PROJECTS=$ADMIN_HOME/Projects
ENV ADMIN_LOGFILES=$ADMIN_HOME/Logfiles
ENV ADMIN_SCRIPTS=$ADMIN_HOME/command-line-installers

RUN useradd \
  --comment "Administrator" \
  --groups adm,dialout,cdrom,floppy,sudo,audio,dip,video,plugdev,ollama \
  --create-home \
  --shell /usr/bin/bash \
  --user-group \
  $ADMIN_USER \
&& echo "$ADMIN_USER:$ADMIN_USER" | chpasswd \
&& chage --lastday 0 $ADMIN_USER \
&& mkdir --parents \
  $ADMIN_PROJECTS \
  $ADMIN_LOGFILES \
  $ADMIN_SCRIPTS \
  $CONTAINER_SHARE

# Set up command line
COPY command-line-installers/* $ADMIN_SCRIPTS/
RUN chown --recursive $ADMIN_USER:$ADMIN_USER $ADMIN_HOME
RUN chown --recursive $ADMIN_USER:$ADMIN_USER $CONTAINER_SHARE
WORKDIR $ADMIN_SCRIPTS
USER $ADMIN_USER
RUN CONTAINER_ID=true ./1_command_line_setup.sh \
  | gzip -9c > $ADMIN_LOGFILES/1_command_line_setup.log.gz

# Go back to root
USER root
WORKDIR $WORKDIR

# Update databases
RUN ./update-databases.sh \
  | gzip -9c > $WORKDIR/update-databases.log.gz

# Script finish check!
RUN gzip -dc $WORKDIR/*.gz | grep "Finished" \
  && gzip -dc $ADMIN_LOGFILES/*.gz | grep "Finished"

# systemd container
CMD /sbin/init
