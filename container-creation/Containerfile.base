FROM docker.io/library/ubuntu:resolute
LABEL maintainer="M. Edward (Ed) Borasky <znmeb@algocompsynth.com>"

# set aside a script / logfile depository
USER root
ENV WORKDIR=/usr/local/src/r-ai-d
WORKDIR $WORKDIR

RUN cat /etc/resolv.conf # check DNS settings

# Environment variables and install scripts
COPY set_container_envars ./
COPY image-installers/* ./

# R-AI-D base
RUN ./r-ai-d-base.sh \
  | gzip -9c > $WORKDIR/r-ai-d-base.log.gz

# Update databases
RUN ./update-databases.sh \
  | gzip -9c > $WORKDIR/update-databases.log.gz

# Script finish check!
RUN gzip -dc $WORKDIR/*.gz | grep "Finished"
